{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stylemind.local/contracts/events/v1/commerce-events.schema.json",
  "title": "StyleMind Commerce and Payment Events V1",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "aggregateId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "enum": ["OrderCreated", "OrderConfirmed", "OrderCancelled", "OrderCompleted", "ReturnApproved", "PaymentConfirmed", "PaymentExpired", "PaymentFailed", "RefundCompleted", "RefundFailed"] },
    "eventVersion": { "type": "integer", "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "aggregateId": { "type": "string" },
    "payload": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
