{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stylemind.local/contracts/events/v1/catalog-events.schema.json",
  "title": "StyleMind Catalog Events V1",
  "oneOf": [
    { "$ref": "#/definitions/ProductCreated" },
    { "$ref": "#/definitions/ProductUpdated" },
    { "$ref": "#/definitions/VariantUpdated" },
    { "$ref": "#/definitions/InventoryChanged" }
  ],
  "definitions": {
    "ProductCreated": { "$ref": "#/definitions/CatalogEvent" },
    "ProductUpdated": { "$ref": "#/definitions/CatalogEvent" },
    "VariantUpdated": { "$ref": "#/definitions/CatalogEvent" },
    "InventoryChanged": { "$ref": "#/definitions/CatalogEvent" },
    "CatalogEvent": {
      "type": "object",
      "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "aggregateId", "payload"],
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "eventType": { "type": "string", "enum": ["ProductCreated", "ProductUpdated", "VariantUpdated", "InventoryChanged"] },
        "eventVersion": { "type": "integer", "const": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "correlationId": { "type": "string" },
        "aggregateId": { "type": "string" },
        "payload": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
