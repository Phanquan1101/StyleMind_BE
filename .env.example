# Copy this file to .env and replace every password placeholder with a local-only random value.
# Never commit .env or put production credentials in this file.
STYLEMIND_POSTGRES_ADMIN_USERNAME=replace-with-local-admin-username
STYLEMIND_POSTGRES_ADMIN_PASSWORD=replace-with-long-random-local-admin-password

STYLEMIND_IDENTITY_DB_URL=jdbc:postgresql://postgres:5432/stylemind_identity
STYLEMIND_IDENTITY_DB_USERNAME=stylemind_identity_app
STYLEMIND_IDENTITY_DB_PASSWORD=replace-with-long-random-identity-password

STYLEMIND_COMMERCE_DB_URL=jdbc:postgresql://postgres:5432/stylemind_commerce
STYLEMIND_COMMERCE_DB_USERNAME=stylemind_commerce_app
STYLEMIND_COMMERCE_DB_PASSWORD=replace-with-long-random-commerce-password

STYLEMIND_PAYMENT_DB_URL=jdbc:postgresql://postgres:5432/stylemind_payment
STYLEMIND_PAYMENT_DB_USERNAME=stylemind_payment_app
STYLEMIND_PAYMENT_DB_PASSWORD=replace-with-long-random-payment-password

STYLEMIND_WARDROBE_COMMUNITY_DB_URL=jdbc:postgresql://postgres:5432/stylemind_wardrobe_community
STYLEMIND_WARDROBE_COMMUNITY_DB_USERNAME=stylemind_wardrobe_community_app
STYLEMIND_WARDROBE_COMMUNITY_DB_PASSWORD=replace-with-long-random-wardrobe-community-password

STYLEMIND_STYLIST_DB_URL=jdbc:postgresql://postgres:5432/stylemind_stylist
STYLEMIND_STYLIST_DB_USERNAME=stylemind_stylist_app
STYLEMIND_STYLIST_DB_PASSWORD=replace-with-long-random-stylist-password

STYLEMIND_NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/stylemind_notification
STYLEMIND_NOTIFICATION_DB_USERNAME=stylemind_notification_app
STYLEMIND_NOTIFICATION_DB_PASSWORD=replace-with-long-random-notification-password

# Generate local secrets; HMAC secret must be base64 for at least 32 random bytes.
STYLEMIND_VERIFICATION_HMAC_SECRET=replace-with-base64-encoded-32-byte-random-secret
STYLEMIND_SERVICE_TOKEN=replace-me

# Identity Login signing config. Generate the local RSA private key at this ignored path.
# Keep the PEM outside source control; Compose mounts it read-only into identity-service.
STYLEMIND_IDENTITY_JWT_PRIVATE_KEY_FILE=./.secrets/stylemind-identity-private.pem
STYLEMIND_JWT_ISSUER=https://identity.stylemind.local
STYLEMIND_JWT_AUDIENCE=stylemind-api
STYLEMIND_JWT_PRIVATE_KEY_PATH=/run/secrets/stylemind-identity-private.pem
STYLEMIND_JWT_ACCESS_TTL=PT15M
STYLEMIND_JWT_REFRESH_TTL=P7D

# Optional local Compose first-Admin bootstrap. Set enabled=true and replace both
# placeholders in the ignored .env to create the first local Admin.
# When enabled, a fresh Identity database gets one ACTIVE, email-verified ADMIN.
# Existing accounts are never modified and this credential does not rotate passwords.
STYLEMIND_BOOTSTRAP_ADMIN_ENABLED=false
STYLEMIND_BOOTSTRAP_ADMIN_EMAIL=replace-with-local-admin@example.com
STYLEMIND_BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-local-admin-password

# Commerce -> Payment handoff: set the same random secret in both service environments.
# Leave empty to fail closed; never commit the actual value.
STYLEMIND_COMMERCE_PAYMENT_TOKEN=

# Local SMTP is captured by the Mailpit service in Docker Compose.
STYLEMIND_SMTP_HOST=mailpit
STYLEMIND_SMTP_PORT=1025
STYLEMIND_SMTP_USERNAME=
STYLEMIND_SMTP_PASSWORD=
STYLEMIND_SMTP_AUTH=false
STYLEMIND_SMTP_STARTTLS=false
STYLEMIND_SMTP_CONNECT_TIMEOUT_MS=3000
STYLEMIND_SMTP_READ_TIMEOUT_MS=5000
STYLEMIND_SMTP_WRITE_TIMEOUT_MS=5000
STYLEMIND_EMAIL_FROM=no-reply@stylemind.local

# Optional Mailjet SMTP profile. Uncomment/configure only in your local .env.
# STYLEMIND_SMTP_HOST=in-v3.mailjet.com
# STYLEMIND_SMTP_PORT=587
# STYLEMIND_SMTP_USERNAME=replace-with-mailjet-api-key
# STYLEMIND_SMTP_PASSWORD=replace-with-mailjet-secret-key
# STYLEMIND_SMTP_AUTH=true
# STYLEMIND_SMTP_STARTTLS=true
# STYLEMIND_EMAIL_FROM=verified-sender@example.com

# SePay PaymentConfirmed -> Commerce: separate shared credential; actual values belong in ignored .env.
STYLEMIND_COMMERCE_SERVICE_TOKEN=
STYLEMIND_PAYMENT_EVENTS_ENABLED=false
STYLEMIND_PAYMENT_EVENTS_POLL_DELAY_MS=10000

# Resource servers verify Identity JWT through the internal Docker network.
STYLEMIND_JWT_JWK_SET_URI=http://identity-service:8081/.well-known/jwks.json
STYLEMIND_JWT_JWS_ALGORITHM=RS256

# Synthetic defaults for local webhook simulation; replace in ignored .env for real banking.
STYLEMIND_SEPAY_WEBHOOK_AUTH_MODE=hmac
STYLEMIND_SEPAY_WEBHOOK_SECRET=
STYLEMIND_SEPAY_WEBHOOK_API_KEY=
STYLEMIND_SEPAY_WEBHOOK_TIMESTAMP_SKEW=5m
STYLEMIND_SEPAY_QR_BANK_NAME=TESTBANK
STYLEMIND_SEPAY_QR_ACCOUNT_NUMBER=000-test-only
STYLEMIND_SEPAY_QR_ACCOUNT_NAME=LOCAL TEST ONLY
STYLEMIND_SEPAY_PAYMENT_CODE_PREFIX=SM
