{
  "info": {
    "name": "StyleMind - US-04.02 Confirm Payment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Synthetic fixtures only on disposable local Orders. Run guide: US-04.02_CONFIRM_PAYMENT_RUN_GUIDE.md. HTTP 200 webhook may acknowledge an exception; verify ledger/Order results. No real credentials included."
  },
  "variable": [
    {
      "key": "paymentUrl",
      "value": "http://localhost:8080/payment"
    },
    {
      "key": "commerceUrl",
      "value": "http://localhost:8080/commerce"
    },
    {
      "key": "sepayApiKey",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "paymentReference",
      "value": ""
    },
    {
      "key": "wrongAmountReference",
      "value": ""
    },
    {
      "key": "latePaymentReference",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "amountVnd",
      "value": "125000"
    },
    {
      "key": "confirmedProviderEventId",
      "value": ""
    },
    {
      "key": "webhookAuthMode",
      "value": "hmac"
    },
    {
      "key": "webhookSecret",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Exact amount (fresh own attempt)",
      "request": {
        "method": "POST",
        "url": "{{paymentUrl}}/internal/v1/sepay/webhooks",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Apikey {{sepayApiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{confirmedProviderEventId}},\n  \"gateway\": \"TESTBANK\",\n  \"accountNumber\": \"000-test-only\",\n  \"code\": \"{{paymentReference}}\",\n  \"transferType\": \"in\",\n  \"transferAmount\": {{amountVnd}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('confirmedProviderEventId', String(Date.now()));",
              "const mode = pm.variables.get('webhookAuthMode');",
              "pm.request.headers.remove('X-SePay-Timestamp');",
              "pm.request.headers.remove('X-SePay-Signature');",
              "if (mode === 'hmac') {",
              "  const secret = pm.variables.get('webhookSecret');",
              "  if (!secret) throw new Error('Set webhookSecret in local Postman variables');",
              "  const timestamp = Math.floor(Date.now() / 1000).toString();",
              "  const body = pm.variables.replaceIn(pm.request.body.raw);",
              "  const signature = CryptoJS.HmacSHA256(timestamp + '.' + body, secret).toString(CryptoJS.enc.Hex);",
              "  pm.request.headers.remove('Authorization');",
              "  pm.request.headers.upsert({key: 'X-SePay-Timestamp', value: timestamp});",
              "  pm.request.headers.upsert({key: 'X-SePay-Signature', value: 'sha256=' + signature});",
              "} else if (mode === 'api-key') {",
              "  pm.request.headers.upsert({key: 'Authorization', value: 'Apikey ' + pm.variables.get('sepayApiKey')});",
              "} else { throw new Error('Use hmac or api-key'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
