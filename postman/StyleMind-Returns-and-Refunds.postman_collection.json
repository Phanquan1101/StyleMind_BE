          "name": "Shop rejects a pickup after inspection",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('allowRefundMutations') !== 'true') { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
