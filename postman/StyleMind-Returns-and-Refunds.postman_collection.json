                "exec": [
                  "pm.test(\"HTTP status\", function () { pm.expect([200]).to.include(pm.response.code); });",
                  "if (pm.response.code < 300) { pm.test(\"Persisted state\", function () { pm.expect(pm.response.json().status).to.eql('REJECTED'); }); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
