              "raw": "{\n  \"action\": \"FAIL_INSPECTION\",\n  \"reason\": \"Hàng khi nhận lại không đạt điều kiện\"\n}"
            },
            "url": "{{baseUrl}}/commerce/api/v1/admin/returns/{{returnId}}/decision"
          }
        },
        {
          "name": "Admin records a failed transfer",
          "event": [
