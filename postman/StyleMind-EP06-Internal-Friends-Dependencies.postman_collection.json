    {
      "name": "01 — Account verification lookup (explicit read opt-in)",
      "item": [
        {
          "name": "Known fixture verification facts",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "pm.request.headers.remove(\"Authorization\");",
                  "pm.request.headers.remove(\"X-StyleMind-Service-Token\");",
                  "if (String(pm.environment.get(\"allowInternalLookup\")) !== \"true\") { pm.execution.skipRequest(); throw new Error(\"Enable explicit test opt-in first\"); }",
                  "const token = pm.environment.get(\"internalServiceToken\");",
                  "if (!token || token.length < 32) { pm.execution.skipRequest(); throw new Error(\"Set internal service token locally\"); }",
                  "pm.request.headers.upsert({key:\"X-StyleMind-Service-Token\",value:token});",
                  "const id=pm.environment.get(\"fixtureAccountId\");",
                  "if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id||\"\")) { pm.execution.skipRequest(); throw new Error(\"Set dedicated fixture account UUID\"); }",
                  "",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "pm.test(\"Expected HTTP status\",()=>pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Stop on unexpected status\"); }",
                  "const data=pm.response.json(); pm.test(\"Safe verification facts\",()=>{pm.expect(data.items).to.be.an(\"array\"); data.items.forEach(item=>pm.expect(Object.keys(item).sort()).to.eql([\"account_id\",\"account_status\",\"email\",\"email_verified_at\"]));});",
                  "",
                  "",
                  "",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_ids\": [\n    \"{{fixtureAccountId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{identityBaseUrl}}/internal/v1/accounts/email-verification-lookup",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "internal",
                "v1",
                "accounts",
                "email-verification-lookup"
              ]
            }
          }
        },
