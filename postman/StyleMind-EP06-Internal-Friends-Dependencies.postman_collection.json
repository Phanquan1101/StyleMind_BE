    {
      "name": "00 — Missing service token (no mail)",
      "item": [
        {
          "name": "Identity missing token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "pm.request.headers.remove(\"Authorization\");",
                  "pm.request.headers.remove(\"X-StyleMind-Service-Token\");",
                  "",
                  "",
                  "",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "pm.test(\"Expected HTTP status\",()=>pm.response.to.have.status(401));",
                  "if (pm.response.code !== 401) { pm.execution.setNextRequest(null); throw new Error(\"Stop on unexpected status\"); }",
                  "",
                  "pm.test(\"Service token required\",()=>pm.expect(pm.response.json().code).to.eql(\"INTERNAL_SERVICE_UNAUTHORIZED\"));",
                  "",
                  "",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_ids\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{identityBaseUrl}}/internal/v1/accounts/email-verification-lookup",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "internal",
