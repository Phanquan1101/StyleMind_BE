{
  "info": {
    "name": "StyleMind EP06 Share Outfits",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Owner-approved PRIVATE/FRIENDS/PUBLIC cutover. Creates and deletes one temporary Outfit. Requires real current friends A/B, outsider C and one purchasable Commerce variant. Explicit opt-in required. Tokens and public link are kept only in the local environment."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.environment.get('allowOutfitSharingTest')!=='true'){pm.execution.skipRequest();throw new Error('Read the run guide and explicitly enable allowOutfitSharingTest for disposable test data');}",
          "['baseUrl','accessTokenA','accessTokenB','accessTokenC','friendAccountA','friendAccountB','variantId'].forEach(k=>{if(!pm.environment.get(k))throw new Error('Missing required environment variable: '+k);});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Create owned PRIVATE outfit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessTokenA}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/wardrobe-community/api/v1/me/outfits",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"EP06 temporary sharing check\",\n  \"creation_source\": \"MANUAL\",\n  \"items\": [\n    {\n      \"variant_id\": \"{{variantId}}\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.environment.set('outfitId',pm.response.json().outfit_id);pm.test('Default PRIVATE',()=>pm.expect(pm.response.json().visibility).to.eql('PRIVATE'));pm.environment.set('ownedItemId',pm.response.json().items[0].outfit_item_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Owner reads settings",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessTokenA}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/wardrobe-community/api/v1/me/outfits/{{outfitId}}/sharing"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('No-store',()=>pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));",
              "pm.test('Private link inactive',()=>{const b=pm.response.json();pm.expect(b.visibility).to.eql('PRIVATE');pm.expect(b.public_enabled).to.eql(false);});"
            ]
          }
        }
      ]
    },
