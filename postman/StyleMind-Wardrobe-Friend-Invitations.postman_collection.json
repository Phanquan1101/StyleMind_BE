        {
          "name": "A invites B",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  " const flag=\"allowFriendInvitationMutations\";",
                  " if (pm.environment.get(flag)!==\"true\") { if (pm.execution.skipRequest) { pm.execution.skipRequest(); return; } pm.request.url=\"http://127.0.0.1:1/disabled\"; throw new Error(\"Enable the fixture flag only in an isolated test environment\"); }",
                  " const bearer=pm.environment.get(\"accessTokenA\");",
                  " if (!bearer) { pm.request.url=\"http://127.0.0.1:1/disabled\"; throw new Error(\"Missing fixture actor token\"); }",
                  " pm.request.headers.upsert({key:\"Authorization\",value:\"Bearer \"+bearer});",
                  " for(const name of [\"friendEmailA\",\"friendEmailB\"]) { const email=pm.environment.get(name)||\"\"; if(!/^[^\\s@]+@[^\\s@]+\\.test$/i.test(email)) { pm.request.url=\"http://127.0.0.1:1/disabled\"; throw new Error(\"Use dedicated .test addresses with a test SMTP inbox only\"); } }",
                  "pm.collectionVariables.unset(\"runInvitationId\");",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  " pm.test(\"Expected HTTP status\",()=>pm.response.to.have.status(201));",
                  " if(pm.response.code!==201) { pm.execution.setNextRequest(null); throw new Error(\"Stop after unexpected fixture response\"); }",
                  " const data=pm.response.json(); pm.test(\"SMTP accepted, not friendship yet\",()=>{pm.expect(data.status).to.eql(\"PENDING\");pm.expect(data.delivery_status).to.eql(\"SMTP_ACCEPTED\");}); pm.collectionVariables.set(\"runInvitationId\",data.friend_invitation_id);",
                  "})();"
                ]
